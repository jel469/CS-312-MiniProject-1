<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit — <%= post.title %> · Field Notes</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,700&family=Manrope:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <div class="page">
      <header class="site-header">
        <p class="brand"><a href="/">Field Notes</a></p>
        <p class="tagline">Editing an existing post</p>
      </header>

      <main>
        <section class="compose" aria-labelledby="edit-heading">
          <h1 id="edit-heading">Edit post</h1>
          <p class="edit-meta">
            Originally posted <time><%= post.createdAt %></time>
          </p>
          <form
            action="/posts/<%= post.id %>?_method=PUT"
            method="POST"
            class="post-form"
          >
            <div class="form-row">
              <label for="author">Your name</label>
              <input
                type="text"
                id="author"
                name="author"
                required
                maxlength="80"
                value="<%= post.author %>"
              />
            </div>
            <div class="form-row">
              <label for="title">Title</label>
              <input
                type="text"
                id="title"
                name="title"
                required
                maxlength="120"
                value="<%= post.title %>"
              />
            </div>
            <div class="form-row">
              <label for="content">Post</label>
              <textarea id="content" name="content" rows="8" required><%= post.content %></textarea>
            </div>
            <div class="form-actions">
              <button type="submit" class="btn btn-primary">Save changes</button>
              <a href="/" class="btn btn-ghost">Cancel</a>
            </div>
          </form>
        </section>
      </main>

      <footer class="site-footer">
        <p>Mini blog · Node.js · Express · EJS</p>
      </footer>
    </div>
  </body>
</html>
